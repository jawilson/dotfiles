[user]
	name = Jeffery Wilson
	email = jeff@jeffalwilson.com
[core]
	autocrlf = input
	editor = git-vscode edit
[alias]
	addnw = !sh -c 'git diff -U0 -w --no-color --src-prefix=a/ --dst-prefix=b/ "$@" | git apply --cached --ignore-whitespace --unidiff-zero -'
	br = branch
	cd = !pushd $(git rev-parse --show-toplevel)
	cfb = "!f() { [ \"$2\" ] && BASE=$2 || BASE=origin/$(git_main_branch) && git checkout --no-track -b $1 $BASE; }; f"
	ci = commit -v
	cl = clone
	co = checkout
	cp = cherry-pick
	cup = "!f(){ b=$1; git fetch --prune; git checkout "$b"; git rebase origin/"$b"; };f"
	dc = diff --cached
	diverge  = ![ "$2" ] && HEAD=$2 || HEAD=HEAD && git diff $(git merge-base --octopus $1 $HEAD)..$HEAD
	last = log -1 --stat
	ldiverge = ![ "$2" ] && HEAD=$2 || HEAD=HEAD && git show $(git merge-base --octopus $1 $HEAD)..$HEAD
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %Cblue<%an>%Creset' --abbrev-commit --date=relative
	lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %Cblue<%an>%Creset' --abbrev-commit --date=relative --all
	log-standup = !git log --since yesterday --author $(git config user.email) --pretty=short
	praise = blame
	pretty-log = log --graph --pretty=format:'%Cred%h%Creset%C(bold yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev=8 --date=relative
	sba = "!f() { [ \"$3\" ] && BRANCH=$3 || BRANCH=$(git_main_branch) && git subtree add --prefix $2 $1 $BRANCH --squash; }; f"
	sbu = "!f() { [ \"$3\" ] && BRANCH=$3 || BRANCH=$(git_main_branch) && git subtree pull --prefix $2 $1 $BRANCH --squash; }; f"
	st = status -sb
	svn-pretty-log = "! f() { git log -n 1000 --graph --color=always --pretty=format:\"%Cred%h%Creset%C(bold yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset%Cred%b%Creset\" --date=relative \"$@\" | parse-git-svn-pretty-log | less -FRS; }; f"
	tarball = ![ "$3" ] && NAME=$3 || NAME=$(basename $(git rev-parse --show-toplevel)) && [ "$2" ] && REF=$2 || REF=HEAD && OUTPUT=$1/$NAME-$(git describe $REF | sed 's,^v,,').tar.gz && git archive --prefix=$NAME/ --output=$OUTPUT $REF^{tree} && readlink -m $OUTPUT && true
	unstage = reset HEAD --
	up = pull --rebase
	diff-split = "!f() { (git diff --numstat \"$@\" | while read -r add del file; do if [ \"$add\" = \"-\" ]; then printf \"%-50s | Binary file\\n\" \"$file\"; else pos=$(printf \"\\033[32m%.0s+\\033[0m\" $(seq 1 $add)); neg=$(printf \"\\033[31m%.0s-\\033[0m\" $(seq 1 $del)); printf \" %-50s | %4s+ %4s-  %s%s\\n\" \"$file\" \"$add\" \"$del\" \"$pos\" \"$neg\"; fi; done; git diff --shortstat \"$@\") | ${GIT_PAGER:-$(git config core.pager || echo ${PAGER:-less})}; }; f"
[color]
	ui = auto
[credential]
	helper = cache
[help]
	autocorrect = 1
[merge]
	tool = vscode
	guitool = vscode
[mergetool]
	guiDefault = true
	keepBackup = false
[mergetool "vscode"]
	cmd = git-vscode merge
	trustExitCode = true
[diff]
	guitool = vscode
	tool = vscode
[difftool "vscode"]
	cmd = git-vscode diff
[push]
	default = simple
	autoSetupRemote = true
[remote-hg]
	hg-git-compat = true
[rerere]
	enabled = 1
[includeIf "hasconfig:remote.*.url:git@github.com:Quartermaster-AI/**"]
	path = .gitconfig-work.inc
[includeIf "hasconfig:remote.*.url:https://github.com/Quartermaster-AI/**"]
	path = .gitconfig-work.inc
[includeIf "gitdir:C:/"]
	path = .gitconfig-windows.inc
[branch]
	autoSetupMerge = simple
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
