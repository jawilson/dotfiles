    "file:///Users/jeff.wilson/.vscode/extensions/continue.continue-2.0.0-darwin-arm64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ]
  },
  "workbench.colorTheme": "Mermaid Dark",
  "terminal.integrated.enableVisualBell": true,
  "pendant.transcriptView": "detailed",
  "gitlens.graph.details.location": "auto",
  "terminal.integrated.middleClickBehavior": "paste",
