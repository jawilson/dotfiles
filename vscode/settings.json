    },
  ],
  "pendant.appendSystemPrompts": [],
  "pendant.autoCompact": true,
  "pendant.autoGenerateSessionNames": true,
  "pendant.binaryPath": "omp",
  "pendant.contextWindowAlignment": "right",
  "pendant.editDiffViewMode": "side-by-side",
  "pendant.editFromHereTarget": "new-editor",
  "pendant.modelThinkingPresets": [],
  "pendant.notifications.agentFinished": true,
  "pendant.runtimeSource": "external",
  "pendant.showThinking": true,
  "pendant.thinkingDisplayMode": "collapseWhenDone",
  "security.workspace.trust.untrustedFiles": "open",
